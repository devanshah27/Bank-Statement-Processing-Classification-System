{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{samples/**,TESTING DATA/**,bank_statement_test_dataset/**,tests/**,training/**,reports/**,docs/**,*.md,*.txt}"
    }
  },
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "env": {
    "OCR_ENGINE": "rapid",
    "DEPLOY_TARGET": "vercel",
    "LOG_LEVEL": "INFO",
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  }
}
