# Deployment target: local | vercel
DEPLOY_TARGET=local

# OCR engine: rapid | tesseract | remote
OCR_ENGINE=rapid

# Remote OCR service URL (only used when OCR_ENGINE=remote)
OCR_SERVICE_URL=

# Cryptographic key for stateless token signatures
CHUNK_SIGNING_KEY=dev-signing-key-change-in-production-use

# Application logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum upload payload size in megabytes
MAX_UPLOAD_SIZE_MB=50

